# Copy this file to `.env` (which is gitignored) and fill in real values.
# Both cloudagent_core and backend read these via pydantic-settings, which
# looks at process environment variables first and falls back to `.env`.

# --- Database (cloudagent_core + backend) ---
# Matches the credentials in docker-compose.yml for local dev.
DATABASE_URL=postgresql+asyncpg://cloudagent:cloudagent@localhost:5432/cloudagent

# --- GitHub App identity (cloudagent_core) ---
# The numeric App ID shown on your GitHub App's settings page.
GITHUB_APP_ID=
# Path to the .pem private key you downloaded when creating the App.
# Never commit the actual key file -- `secrets/` is gitignored for this.
GITHUB_APP_PRIVATE_KEY_PATH=./secrets/github-app-private-key.pem

# --- Redis (backend only, for SSE pub/sub) ---
REDIS_URL=redis://localhost:6379/0

# --- Session cookie signing (backend only) ---
# Any long random string. Rotating this logs every user out.
SESSION_SECRET_KEY=change-me-to-a-long-random-string

# --- "Sign in with GitHub" OAuth app (backend only) ---
# This is a *separate* GitHub registration from the GitHub App above --
# a plain OAuth App used only to answer "who is this person", not to get
# repo access.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# --- GitHub App webhook (backend only) ---
GITHUB_APP_WEBHOOK_SECRET=change-me

# --- GitHub App public slug (backend only) ---
# From your App's public page URL: github.com/apps/<this-part>
GITHUB_APP_SLUG=

# --- E2B sandbox provisioning (backend only, management-plane) ---
E2B_API_KEY=
E2B_SANDBOX_TEMPLATE=base

# --- Backend <-> Agent Loop internal RPC (shared by both services) ---
# AGENT_LOOP_BASE_URL is only the *fallback* backend uses when no Agent
# Loop instance has registered itself in Redis yet (see
# backend/app/clients/agent_loop_client.py) -- with a single local
# instance running, that's the normal case.
AGENT_LOOP_BASE_URL=http://localhost:8001
INTERNAL_SHARED_SECRET=change-me

# --- Agent Loop only: LLM provider selection (claude/agent-loop-plan.md §4) ---
# "anthropic", "llama", or "azure_openai" -- selects which adapter
# agent_loop/app/main.py constructs; nothing else in the codebase
# branches on this.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
LLAMA_API_KEY=
LLAMA_BASE_URL=https://api.together.xyz/v1
LLAMA_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo

# --- Azure OpenAI (only used when LLM_PROVIDER=azure_openai) ---
# AZURE_OPENAI_ENDPOINT looks like https://<resource-name>.openai.azure.com
# AZURE_OPENAI_DEPLOYMENT is the deployment name you chose in the Azure
# portal when you deployed a model -- not the underlying model name.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21

# --- Agent Loop only: instance identity/routing (§5.1) ---
# The URL this instance advertises to backend for direct routing when
# Fly's internal-DNS pattern doesn't apply (FLY_MACHINE_ID/FLY_APP_NAME
# unset) -- i.e. local dev. Irrelevant in production on Fly.
AGENT_LOOP_PUBLIC_URL=http://localhost:8001

# --- Frontend/backend origins (backend only) ---
# Used for CORS and for building the GitHub OAuth redirect target.
FRONTEND_BASE_URL=http://localhost:5173
BACKEND_BASE_URL=http://localhost:8000
